<?xml version="1.0" encoding="utf-8"?>
<!-- LIGHT palette: clean, high-contrast, with a vibrant green + amber accent.
     The same names are redefined in values-night/colors.xml for dark mode. -->
<resources>
    <!-- Kept so any existing @color/black or @color/white references still resolve -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Primary (vibrant green) -->
    <color name="fit_primary">#00693B</color>
    <color name="fit_on_primary">#FFFFFF</color>
    <color name="fit_primary_container">#98F7BC</color>
    <color name="fit_on_primary_container">#002110</color>
    <color name="fit_primary_inverse">#4ADE80</color>

    <!-- Secondary (calm green-grey) -->
    <color name="fit_secondary">#4F6354</color>
    <color name="fit_on_secondary">#FFFFFF</color>
    <color name="fit_secondary_container">#D2E8D5</color>
    <color name="fit_on_secondary_container">#0D1F13</color>

    <!-- Tertiary (energetic amber/orange accent) -->
    <color name="fit_tertiary">#9A4500</color>
    <color name="fit_on_tertiary">#FFFFFF</color>
    <color name="fit_tertiary_container">#FFDBC8</color>
    <color name="fit_on_tertiary_container">#331200</color>

    <!-- Error -->
    <color name="fit_error">#BA1A1A</color>
    <color name="fit_on_error">#FFFFFF</color>
    <color name="fit_error_container">#FFDAD6</color>
    <color name="fit_on_error_container">#410002</color>

    <!-- Background and surfaces -->
    <color name="fit_background">#FBFDF8</color>
    <color name="fit_on_background">#191C19</color>
    <color name="fit_surface">#FBFDF8</color>
    <color name="fit_on_surface">#191C19</color>
    <color name="fit_surface_variant">#DDE5DB</color>
    <color name="fit_on_surface_variant">#414941</color>
    <color name="fit_surface_inverse">#2E312E</color>
    <color name="fit_on_surface_inverse">#EFF1EC</color>
    <color name="fit_outline">#717971</color>
    <color name="fit_outline_variant">#C1C9BF</color>

    <!-- Surface containers (used by cards, dialogs, nav surfaces) -->
    <color name="fit_surface_container_lowest">#FFFFFF</color>
    <color name="fit_surface_container_low">#F2F5F0</color>
    <color name="fit_surface_container">#ECEFEA</color>
    <color name="fit_surface_container_high">#E6E9E4</color>
    <color name="fit_surface_container_highest">#E1E3DE</color>
</resources>